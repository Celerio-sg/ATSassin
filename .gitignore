/target
__pycache__/
*.pyc
.atsassin.db
*.sqlite
*.db
.env
.env.local
# Root-anchored (leading /): these are locally-generated runtime artifacts
# at the project root, not a ban on the filename/extension anywhere in the
# repo - a bare pattern here previously and silently excluded the real
# `tests/uat/*/profile.md` fixtures the test suite depends on, since
# unanchored gitignore patterns match at any depth.
/config.toml
/config.yml
/profile.md
/*.pdf
/*.docx
.DS_Store
Thumbs.db

# Demo recording artifacts (real recordings are committed to assets/, but intermediate captures and local demo DBs are not)
/demo_data/
/demo_capture.*


# AI-tooling artifacts, not part of the project
.kilo/
session-ses_*.md

# Competitor clones pulled in for benchmarking (see docs/COMPETITIVE_BENCHMARK_2026-07-25.md) -
# other projects' full source trees, not part of ATSassin itself
/benchmarks/

# Generated application kits (contain PII - tailored resumes, cover letters)
/apply_kit_*/
/tailored_*

# LLM telemetry logs (contain full prompt/response traces)
*.llm_telemetry.jsonl

# Demo scratch files (raw tapes, intermediate captures, local scaffolds)
/demo.tape
/demo_vhs.tape
/demo_jd.txt
/scripts/Dockerfile.vhs
/scripts/capture_demo.ps1
/scripts/demo.ps1
/scripts/demo_vhs.tape
/scripts/make_demo_gif.py
/scripts/make_opengraph.py

# Batch-issue-creation helpers (one-shot utility, not part of the project)
/scripts/create_comprehensive_issues.sh

# Real personal LinkedIn export used as a local test fixture - contains real
# names/emails/phone numbers (the account owner's and their connections').
# Never commit this. If an example LinkedIn-export fixture is needed for
# docs/tests, it must be synthetic/anonymized data checked in deliberately.
/assets/examples/

# Real CV/resume exports kept at the project root as local scan/parse inputs.
# These are a real person's employment history. Root-anchored so the synthetic
# `tests/uat/*/profile.md` fixtures are unaffected. A bare `git add -A` was
# previously enough to publish these to a public repo.
/tail-*.md
/*-resume.md
/*-cv.md
/cv.md
/resume.md

# Local database of an unrelated desktop application that writes inside this
# working tree. Not an ATSassin artifact; the directory itself needs ignoring,
# not just the *.db files the rules above already catch.
/.freebuff/
