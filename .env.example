# LLM_PROVIDER: ollama | groq | openrouter | openai | anthropic | kimi | glm | lightning | custom
# --preset (lightweight/balanced/full) only changes the model tier for `ollama`.
# For every hosted provider, --preset changes timeout/retries/scrape-limits ONLY -
# the model is whatever <PROVIDER>_MODEL below is set to.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
GLM_API_KEY=
GLM_MODEL=glm-5.2
MOONSHOT_BASE_URL=https://api.moonshot.cn
GLM_BASE_URL=https://open.bigmodel.cn
LIGHTNING_USER_ID=
LIGHTNING_API_KEY=
LIGHTNING_BASE_URL=https://api.lightning.ai
LIGHTNING_MODEL=meta-llama/Llama-4-Maverick-17B
DATABASE_PATH=atsassin.db
PROFILE_PATH=profile.md
